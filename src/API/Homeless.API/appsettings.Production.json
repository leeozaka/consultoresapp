{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "ReadConnection": "",
    "Redis": ""
  },
  "EnableDatabasePurge": false,
  "App": {
    "LandingDomain": "consultor.app",
    "LandingTenantSlug": "landing"
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "consultores",
    "Password": "consultores",
    "PrefetchCount": 16
  },
  "OpenIddict": {
    "Issuer": "https://api.consultor.app",
    "SpaRedirectUri": "https://consultor.app/auth/callback",
    "SpaPostLogoutUri": "https://consultor.app"
  },
  "SuperAdmin": {
    "Email": "superadmin@consultor.app",
    "Password": ""
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.stripe.com"
  },
  "R2": {
    "AccountId": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "",
    "PublicBaseUrl": ""
  },
  "Storage": {
    "LocalPath": "uploads"
  },
  "ImageProcessing": {
    "MaxFileSizeBytes": 20971520,
    "WebPQuality": 90,
    "ChannelCapacity": 100,
    "ThumbnailWidth": 400,
    "MediumWidth": 900,
    "FullWidth": 1600
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Caching": {
    "PropertyTtlSeconds": 300,
    "IdempotencyTtlSeconds": 300,
    "EntitlementTtlSeconds": 600,
    "TenantTtlSeconds": 300
  },
  "Concurrency": {
    "LockDefaultTimeoutSeconds": 30,
    "LockEvictionIntervalSeconds": 120,
    "LockMaxIdleSeconds": 300,
    "SagaTimeoutSeconds": 30
  },
  "Resilience": {
    "Default": {
      "TimeoutSeconds": 5,
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 200,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerSamplingDurationSeconds": 30,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerBreakDurationSeconds": 30
    },
    "Database": {
      "TimeoutSeconds": 10,
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 500,
      "CircuitBreakerFailureRatio": 0.3,
      "CircuitBreakerSamplingDurationSeconds": 60,
      "CircuitBreakerMinimumThroughput": 3,
      "CircuitBreakerBreakDurationSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Homeless.Infrastructure.Caching": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
}
