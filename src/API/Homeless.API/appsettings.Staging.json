{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "ReadConnection": "",
    "Redis": ""
  },
  "EnableDatabasePurge": true,
  "App": {
    "LandingDomain": "staging.consultor.app",
    "LandingTenantSlug": "landing",
    "SandboxMode": true
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "consultores",
    "Password": "consultores",
    "PrefetchCount": 16
  },
  "OpenIddict": {
    "Issuer": "https://api.staging.consultor.app",
    "SpaRedirectUri": "https://staging.consultor.app/auth/callback",
    "SpaPostLogoutUri": "https://staging.consultor.app"
  },
  "SuperAdmin": {
    "Email": "",
    "Password": ""
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "BaseUrl": "http://payment-simulator:8080"
  },
  "R2": {
    "AccountId": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "",
    "PublicBaseUrl": ""
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Homeless.Infrastructure.Caching": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "Resilience": {
    "Default": {
      "TimeoutSeconds": 5,
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 200,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerSamplingDurationSeconds": 30,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerBreakDurationSeconds": 30
    },
    "Database": {
      "TimeoutSeconds": 10,
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 500,
      "CircuitBreakerFailureRatio": 0.3,
      "CircuitBreakerSamplingDurationSeconds": 60,
      "CircuitBreakerMinimumThroughput": 3,
      "CircuitBreakerBreakDurationSeconds": 60
    }
  }
}
