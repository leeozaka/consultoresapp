# ──────────────────────────────────────────────────────────────────────────────
# STAGING SECRETS — Do NOT commit live values.
#
# Staging uses its own database, its own R2 bucket, and its own OpenIddict
# certificates.
#
# Setup:
#   1. Copy this file → secrets.yaml
#   2. Fill in all values
#   3. kubectl apply -n consultores-staging -f secrets.yaml
#   4. Delete the local file immediately
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: consultores-secrets
  namespace: consultores-staging
type: Opaque
stringData:
  # ── Database (separate from production!) ─────────────────────────────────────
  ConnectionStrings__DefaultConnection: "Host=<staging-db-host>;Port=25060;Database=homeless_staging;Username=consultores_staging;Password=<password>;sslmode=require;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=50;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=15"
  ConnectionStrings__ReadConnection: "Host=<staging-db-host>;Port=25060;Database=homeless_staging;Username=consultores_staging;Password=<password>;sslmode=require;Pooling=true;Minimum Pool Size=2;Maximum Pool Size=25;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=10"

  # ── SuperAdmin ───────────────────────────────────────────────────────────────
  SuperAdmin__Email: "superadmin@staging.consultor.app"
  SuperAdmin__Password: "<staging-password>"

  # ── R2 (separate bucket or same bucket with prefix) ──────────────────────────
  R2__AccountId: "<cloudflare-account-id>"
  R2__AccessKey: "<staging-r2-access-key>"
  R2__SecretKey: "<staging-r2-secret-key>"
  R2__BucketName: "property-photos-staging"
  R2__PublicBaseUrl: "https://pub-<id>.r2.dev"

  # ── OpenIddict X.509 certificates (separate from production!) ────────────────
  OPENIDDICT_SIGNING_CERT_PFX_B64: "<base64-encoded-staging-signing-pfx>"
  OPENIDDICT_ENCRYPTION_CERT_PFX_B64: "<base64-encoded-staging-encryption-pfx>"
