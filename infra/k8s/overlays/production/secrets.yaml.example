# ──────────────────────────────────────────────────────────────────────────────
# TEMPLATE — Do NOT commit live secrets to version control.
#
# In CI/CD (GitHub Actions), these values are injected at deploy time using the
# GitHub Secrets listed in README.md → "Required GitHub Secrets".
#
# For a manual deploy:
#   1. Copy this file to secrets.yaml (gitignored)
#   2. Run: terraform output -raw db_write_connection_string
#   3. Fill in all values below
#   4. Run: kubectl apply -f infra/k8s/secrets.yaml
#   5. Delete the local secrets.yaml immediately after — never leave it on disk.
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: consultores-secrets
  namespace: consultores
type: Opaque
stringData:
  # ── Database (from: terraform output -raw db_write_connection_string) ────────
  ConnectionStrings__DefaultConnection: "Host=<db-private-host>;Port=25060;Database=homeless;Username=consultores_app;Password=<password>;sslmode=require;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=150;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=15"
  ConnectionStrings__ReadConnection: "Host=<db-private-host>;Port=25060;Database=homeless;Username=consultores_app;Password=<password>;sslmode=require;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=10"

  # ── SuperAdmin ───────────────────────────────────────────────────────────────
  SuperAdmin__Email: "superadmin@consultor.app"
  SuperAdmin__Password: "<strong-generated-password>"

  # ── Cloudflare R2 object storage ─────────────────────────────────────────────
  R2__AccountId: "<cloudflare-account-id>"
  R2__AccessKey: "<r2-access-key-id>"
  R2__SecretKey: "<r2-secret-access-key>"
  R2__BucketName: "property-photos"
  R2__PublicBaseUrl: "https://pub-<id>.r2.dev"

  # ── OpenIddict X.509 certificates ────────────────────────────────────────────
  # Generate signing cert:
  #   openssl req -x509 -newkey rsa:4096 -keyout signing.key -out signing.crt -days 3650 -nodes -subj "/CN=consultores-signing"
  #   openssl pkcs12 -export -out signing.pfx -inkey signing.key -in signing.crt -passout pass:
  #   base64 -i signing.pfx | tr -d '\n'
  #
  # Repeat for the encryption cert.
  OPENIDDICT_SIGNING_CERT_PFX_B64: "<base64-encoded-signing-pfx>"
  OPENIDDICT_ENCRYPTION_CERT_PFX_B64: "<base64-encoded-encryption-pfx>"
  # ── Redis ───────────────────────────────────────────────────────────────────
  # Generate a strong password:
  #   openssl rand -base64 32
  Redis__Password: "<strong-generated-password>"
  # StackExchange.Redis connection string including the password above:
  ConnectionStrings__Redis: "redis:6379,password=<strong-generated-password>,abortConnect=false"
