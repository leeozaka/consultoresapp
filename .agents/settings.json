{
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "terraform@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli",
        "mcp"
      ],
      "type": "stdio"
    },
    "primeng": {
      "command": "npx",
      "args": [
        "-y",
        "@primeng/mcp"
      ],
      "type": "stdio"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "type": "stdio"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "serena@latest",
        "--context",
        "ide-assistant"
      ],
      "type": "stdio"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "redis": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ],
      "type": "stdio"
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_ADDRESS",
        "-e",
        "TFE_TOKEN",
        "-e",
        "ENABLE_TF_OPERATIONS",
        "hashicorp/terraform-mcp-server:0.4.0"
      ],
      "type": "stdio",
      "env": {
        "TFE_ADDRESS": "${TFE_ADDRESS}",
        "TFE_TOKEN": "${TFE_TOKEN}",
        "ENABLE_TF_OPERATIONS": "${ENABLE_TF_OPERATIONS:-false}"
      }
    }
  }
}
