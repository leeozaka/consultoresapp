{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "ReadConnection": "",
    "Redis": ""
  },
  "EnableDatabasePurge": false,
  "App": {
    "LandingDomain": "consultor.app",
    "LandingTenantSlug": "landing"
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "consultores",
    "Password": "consultores",
    "PrefetchCount": 16
  },
  "OpenIddict": {
    "Issuer": "https://api.consultor.app",
    "SpaRedirectUri": "http://localhost:3000/auth/callback",
    "SpaPostLogoutUri": "http://localhost:3000"
  },
  "SuperAdmin": {
    "Email": "superadmin@consultor.dev",
    "Password": "CHANGE_ME_BEFORE_PRODUCTION!"
  },
  "R2": {
    "AccountId": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "",
    "PublicBaseUrl": ""
  },
  "Storage": {
    "LocalPath": "uploads"
  },
  "ImageProcessing": {
    "MaxFileSizeBytes": 20971520,
    "WebPQuality": 90,
    "ChannelCapacity": 100,
    "ThumbnailWidth": 400,
    "MediumWidth": 900,
    "FullWidth": 1600
  },
  "Seq": {
    "ServerUrl": "http://seq:5341"
  },
  "Caching": {
    "PropertyTtlSeconds": 300,
    "IdempotencyTtlSeconds": 300,
    "EntitlementTtlSeconds": 600,
    "TenantTtlSeconds": 300
  },
  "Concurrency": {
    "LockDefaultTimeoutSeconds": 30,
    "LockEvictionIntervalSeconds": 120,
    "LockMaxIdleSeconds": 300,
    "SagaTimeoutSeconds": 30
  },
  "Resilience": {
    "Default": {
      "TimeoutSeconds": 0,
      "MaxRetryAttempts": 0,
      "RetryDelayMs": 0,
      "CircuitBreakerFailureRatio": 0,
      "CircuitBreakerSamplingDurationSeconds": 0,
      "CircuitBreakerMinimumThroughput": 0,
      "CircuitBreakerBreakDurationSeconds": 0
    },
    "Database": {
      "TimeoutSeconds": 0,
      "MaxRetryAttempts": 0,
      "RetryDelayMs": 0,
      "CircuitBreakerFailureRatio": 0,
      "CircuitBreakerSamplingDurationSeconds": 0,
      "CircuitBreakerMinimumThroughput": 0,
      "CircuitBreakerBreakDurationSeconds": 0
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Homeless.Infrastructure.Caching": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.stripe.com"
  },
  "AllowedHosts": "*"
}
